<div class="max-w-xl mx-auto bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
  <h1 class="text-2xl font-bold text-slate-900 mb-2">Войти</h1>
  <p class="text-sm text-slate-500 mb-6">Войдите, чтобы видеть историю своих мероприятий.</p>

  <%= form_with url: session_path, method: :post, class: "space-y-4" do %>
    <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>

    <div>
      <%= label_tag :email, "Email", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= email_field_tag :email,
                          params[:email],
                          required: true,
                          autocomplete: "email",
                          class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-slate-900" %>
    </div>

    <div>
      <%= label_tag :password, "Пароль", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= password_field_tag :password,
                             nil,
                             required: true,
                             autocomplete: "current-password",
                             class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-slate-900" %>
    </div>

    <%= submit_tag "Войти",
                   class: "w-full rounded-xl bg-blue-600 px-5 py-3 text-white font-semibold cursor-pointer" %>
  <% end %>

  <div class="mt-6 text-sm text-center text-slate-500">
    Нет аккаунта?
    <%= link_to "Зарегистрироваться",
                new_registration_path(return_to: params[:return_to]),
                class: "text-blue-600 font-semibold" %>
  </div>
</div>
