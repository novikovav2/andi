<!DOCTYPE html>
<html>
  <head>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Andi">
    <meta name="mobile-web-app-capable" content="yes">
    <%= display_meta_tags site: "Анди" %>
    <%= display_meta_tags(default_meta_tags) %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= asset_path('icons/favicon.ico') %>">
    <link rel="icon" type="image/png" sizes="32x32" href="<%= asset_path('icons/favicon-32.png') %>">
    <link rel="icon" type="image/png" sizes="16x16" href="<%= asset_path('icons/favicon-16.png') %>">
    <link rel="apple-touch-icon" sizes="180x180" href="<%= asset_path('icons/apple-touch-icon.png') %>">
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#3B82F6">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%#= stylesheet_link_tag :app %>
    <%= stylesheet_link_tag "application", "shared", "events", "dashboard", "home", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <!-- Yandex.Metrika counter -->
    <script type="text/javascript">
        (function(m,e,t,r,i,k,a){
            m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
            m[i].l=1*new Date();
            for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
            k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
        })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=109518545', 'ym');

        ym(109518545, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/109518545" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GZ73HGZ2KD"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-GZ73HGZ2KD');
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  </head>

  <body>
    <%= render "shared/flash" %>
    <main class="app-screen">
      <div class="app-container">
        <header class="flex items-center justify-between gap-4 mb-6">
          <%= render "shared/app_brand" %>

          <%= render "shared/user_nav" %>
        </header>

        <%= yield %>
        <%= render "shared/footer" %>
      </div>
    </main>

    <% unless cookies[:andi_cookie_notice_accepted] == "true" %>
      <%= render "shared/cookie_banner" %>
    <% end %>
  </body>
</html>
