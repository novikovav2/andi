<div class="max-w-xl mx-auto bg-white rounded-2xl border border-slate-100 shadow-sm p-6">
  <h1 class="text-2xl font-bold text-slate-900 mb-2">Регистрация</h1>
  <p class="text-sm text-slate-500 mb-6">Создайте аккаунт, чтобы сохранять историю мероприятий.</p>

  <%= form_with model: @user, url: registration_path, class: "space-y-4" do |form| %>
    <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>

    <% if @user.errors.any? %>
      <div class="rounded-xl bg-red-50 border border-red-200 p-4 text-sm text-red-500">
        <%= @user.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div>
      <%= form.label :name, "Имя", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.text_field :name,
                          autocomplete: "name",
                          class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-slate-900" %>
    </div>

    <div>
      <%= form.label :email, "Email", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.email_field :email,
                           required: true,
                           autocomplete: "email",
                           class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-slate-900" %>
    </div>

    <div>
      <%= form.label :password, "Пароль", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.password_field :password,
                              required: true,
                              autocomplete: "new-password",
                              class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-slate-900" %>
    </div>

    <div>
      <%= form.label :password_confirmation, "Повторите пароль", class: "block text-sm font-medium text-slate-700 mb-1" %>
      <%= form.password_field :password_confirmation,
                              required: true,
                              autocomplete: "new-password",
                              class: "w-full rounded-xl border border-slate-200 px-4 py-3 text-slate-900" %>
    </div>

    <%= form.submit "Создать аккаунт",
                    class: "w-full rounded-xl bg-blue-600 px-5 py-3 text-white font-semibold cursor-pointer" %>
  <% end %>

  <div class="mt-6 text-sm text-center text-slate-500">
    Уже есть аккаунт?
    <%= link_to "Войти",
                new_session_path(return_to: params[:return_to]),
                class: "text-blue-600 font-semibold" %>
  </div>
</div>
