<div class="min-h-screen bg-slate-50 px-4 py-6">
  <div class="max-w-xl mx-auto">
    <%= render "shared/back_link", path: event_share_path(@event.access_token) %>

    <div class="bg-white rounded-2xl shadow-sm p-5 mb-6">
      <p class="text-sm text-slate-400 mb-1">
        Расчёт участника
      </p>

      <h1 class="text-2xl font-semibold text-slate-900">
        <%= @from.name %>
      </h1>

      <div class="mt-4 text-3xl font-semibold text-slate-900">
        <%= rubles(@net_owed_cents) %>
      </div>

      <p class="text-sm text-slate-500 mt-3">
        Это итоговая сумма, которую участник должен перевести по результатам всех трат.
      </p>
    </div>

    <div class="section-header">
      <div>
        <h2 class="section-title">
          Итоговые переводы
        </h2>

        <p class="section-subtitle">
          Как Анди упростил расчёт
        </p>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm p-5 mb-6">
      <h3 class="font-semibold text-slate-900">
        Как Анди упростил переводы
      </h3>

      <p class="text-sm text-slate-500 mt-2">
        Сначала Анди считает долги по каждой покупке, а затем делает взаимозачёт, чтобы переводов было меньше.
      </p>

      <div class="mt-5">
        <h4 class="text-sm font-semibold text-slate-500 mb-3">
          До взаимозачёта
        </h4>

        <div class="space-y-2">
          <% @raw_debts.each do |debt| %>
            <div class="flex items-start justify-between gap-3 rounded-2xl bg-slate-50 px-4 py-3">
              <div class="min-w-0">
                <div class="text-sm font-semibold text-slate-800">
                  <%= debt[:from].name %> → <%= debt[:to].name %>
                </div>

                <div class="text-xs text-slate-400 mt-1">
                  за «<%= debt[:expense].title %>»
                </div>
              </div>

              <div class="text-sm font-semibold text-slate-900 whitespace-nowrap">
                <%= rubles(debt[:amount_cents]) %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-5">
        <h4 class="text-sm font-semibold text-slate-500 mb-3">
          После взаимозачёта
        </h4>

        <p class="text-sm text-slate-500 mb-3">
          Анди уменьшает количество переводов, поэтому сумма конкретного перевода может отличаться от доли в отдельной покупке.
        </p>

        <div class="settlements-list">
          <% @outgoing_settlements.each do |settlement| %>
            <%= render "balance_explanations/settlement",
                       settlement: settlement,
                       active: settlement.to_participant_id == @to.id %>
          <% end %>
        </div>
      </div>
    </div>

    <div class="section-header">
      <div>
        <h2 class="section-title">
          Из чего сложился расчёт участника
        </h2>
      </div>
    </div>

    <div class="space-y-3">
      <% @rows.each do |row| %>
        <% expense = row[:expense] %>

        <div class="bg-white rounded-2xl shadow-sm p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <div class="font-medium text-slate-900">
                🍔 <%= expense.title %>
              </div>

              <div class="text-sm text-slate-400 mt-1">
                Оплатил <%= expense.payer.name %>
              </div>

              <div class="text-sm text-slate-500 mt-3">
                Общая стоимость:
                <div class="font-medium text-slate-700">
                  <%= rubles(expense.amount_cents) %>
                </div>
              </div>

              <% if expense.weighted_split? %>
                <div class="text-sm text-slate-500 mt-1">
                  Разделили по количеству
                </div>
              <% else %>
                <div class="text-sm text-slate-500 mt-1">
                  Разделили поровну между <%= row[:participants_count] %> участниками
                </div>
              <% end %>

              <div class="flex flex-wrap gap-2 mt-3">
                <% row[:participants].each do |participant| %>
          <span class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-600">
            <%= participant.name %>
          </span>
                <% end %>
              </div>
            </div>

            <div class="text-right whitespace-nowrap">
              <div class="font-semibold text-slate-900">
                <%= rubles(row[:amount_cents]) %>
              </div>

              <div class="text-xs text-slate-400 mt-1">
                Доля в трате
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @rows.empty? %>
      <div class="bg-white rounded-2xl shadow-sm p-6 text-center text-slate-400">
        Не удалось найти подробности расчёта.
      </div>
    <% end %>
  </div>
</div>
