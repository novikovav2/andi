<%= turbo_frame_tag "modal" do %>
  <div data-controller="modal" class="fixed inset-0 bg-black/30 flex items-end justify-center z-50">
    <div class="bg-white rounded-t-3xl w-full max-w-xl p-5 max-h-[90vh] overflow-y-auto">

      <div class="w-12 h-1.5 bg-slate-300 rounded-full mx-auto mb-5"></div>

      <div class="flex items-center justify-between mb-6">
        <h1 class="text-xl font-semibold text-slate-900">
          Изменить трату
        </h1>

        <%= link_to "✕",
                    "#",
                    data: {
                      action: "click->modal#close"
                    },
                    class: "text-slate-400 text-xl" %>
      </div>

      <%= form_with model: [@event, @expense],
                    data: { controller: "expense-form" } do |f| %>
        <div class="space-y-4">

          <%= f.text_field :title,
                           data: {
                             expense_form_target: "name",
                             action: "input->expense-form#updateButton"
                           },
                           class: "w-full rounded-xl border border-slate-200 px-4 py-3" %>

          <%= f.text_field :amount,
                           value: @expense.amount_cents / 100.0,
                           inputmode: "decimal",
                           data: {
                             expense_form_target: "amount",
                             action: "input->expense-form#updateButton"
                           },
                           class: "w-full rounded-xl border border-slate-200 px-4 py-3" %>

          <div>
            <p class="text-sm text-slate-500 mb-2">Оплатил</p>

            <div class="flex flex-wrap gap-2">
              <% @participants.each do |participant| %>
                <label class="participant-chip">
                  <%= radio_button_tag "expense[payer_id]",
                                       participant.id,
                                       @expense.payer_id == participant.id %>

                  <span><%= participant.name %></span>
                </label>
              <% end %>
            </div>
          </div>

          <div>
            <p class="text-sm text-slate-500 mb-2">
              Кто участвовал
            </p>

            <div class="flex flex-wrap gap-2">
              <% @participants.each do |participant| %>
                <label class="participant-chip">
                  <%= check_box_tag "expense[participant_ids][]",
                                    participant.id,
                                    @expense.participant_ids.include?(participant.id),
                                    data: {
                                      expense_form_target: "participantCheckbox",
                                      participant_id: participant.id,
                                      action: "change->expense-form#updateQuantityRows"
                                    } %>

                  <span><%= participant.name %></span>
                </label>
              <% end %>
            </div>
          </div>

          <div>
            <p class="text-sm text-slate-500 mb-2">Как делим?</p>

            <div class="expense-split-mode">
              <label class="expense-split-mode-option">
                <%= radio_button_tag "expense[split_mode]",
                                     "equal",
                                     !@expense.weighted_split?,
                                     data: {
                                       expense_form_target: "splitMode",
                                       action: "change->expense-form#updateSplitMode"
                                     } %>
                <span>Поровну</span>
              </label>

              <label class="expense-split-mode-option">
                <%= radio_button_tag "expense[split_mode]",
                                     "quantity",
                                     @expense.weighted_split?,
                                     data: {
                                       expense_form_target: "splitMode",
                                       action: "change->expense-form#updateSplitMode"
                                     } %>
                <span>По количеству</span>
              </label>
            </div>
          </div>

          <div class="expense-share-weights" data-expense-form-target="quantityFields" <%= "hidden" unless @expense.weighted_split? %>>
            <p class="text-sm font-semibold text-slate-700">Сколько досталось каждому</p>
            <p class="text-xs text-slate-500 mt-1 mb-3">
              Укажите количество или доли. Анди разделит сумму пропорционально.
            </p>

            <div class="expense-share-weight-list">
              <% share_weights = @participants.map do |participant|
                   @expense.expense_shares.find { |expense_share| expense_share.participant_id == participant.id }&.weight || 1
                 end %>
              <% max_share_weight = share_weights.max || 0 %>

              <% @participants.each do |participant| %>
                <% share = @expense.expense_shares.find { |expense_share| expense_share.participant_id == participant.id } %>
                <% weight = share&.weight || 1 %>
                <% formatted_weight = format_expense_share_weight(weight) %>

                <label class="expense-share-weight-row"
                       data-expense-form-target="quantityRow"
                       data-participant-id="<%= participant.id %>"
                       <%= "hidden" unless @expense.participant_ids.include?(participant.id) %>>
                  <span class="expense-share-weight-name"><%= participant.name %></span>
                  <span class="expense-share-weight-bar" aria-hidden="true">
                    <span class="expense-share-weight-fill"
                          data-expense-form-target="weightFill"
                          style="width: <%= expense_share_bar_width(weight, max_share_weight) %>"></span>
                  </span>
                  <span class="expense-share-weight-control">
                    <button type="button"
                            class="expense-share-weight-stepper"
                            aria-label="Уменьшить количество для <%= participant.name %>"
                            data-action="click->expense-form#decrementWeight">
                      −
                    </button>
                    <span class="expense-share-weight-value" data-expense-form-target="weightValue"><%= formatted_weight %></span>
                    <button type="button"
                            class="expense-share-weight-stepper"
                            aria-label="Увеличить количество для <%= participant.name %>"
                            data-action="click->expense-form#incrementWeight">
                      +
                    </button>
                    <%= number_field_tag "expense[share_weights][#{participant.id}]",
                                         formatted_weight,
                                         min: 0,
                                         step: "0.5",
                                         inputmode: "decimal",
                                         data: {
                                           expense_form_target: "weightInput",
                                           action: "input->expense-form#updateShareBars"
                                         },
                                         class: "expense-share-weight-input" %>
                  </span>
                </label>
              <% end %>
            </div>

            <div class="expense-share-weight-total" data-expense-form-target="weightTotal">
              Всего: <%= expense_share_total_label(share_weights) %>
            </div>
          </div>

          <%= f.submit "Сохранить",
                       data: { expense_form_target: "submit" },
                       class: "w-full rounded-xl bg-blue-500 text-white py-3 font-medium cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-4">
        <%= button_to "Удалить трату",
                      event_expense_path(@event, @expense),
                      method: :delete,
                      form: {
                        data: {
                          controller: "removable"
                        }
                      },
                      data: {
                        action: "click->removable#remove"
                      },
                      class: "w-full rounded-xl border border-red-200 text-red-500 py-3 font-medium" %>
      </div>
    </div>
  </div>
<% end %>
