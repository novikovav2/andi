<% if participants.any? %>
  <div class="bg-white rounded-2xl shadow-sm p-4 mb-6">
    <h2 class="font-semibold text-slate-900 mb-4">Добавить трату</h2>

    <%= form_with model: [event, expense],
                  data: { controller: "expense-presets expense-form" } do |f| %>
      <div class="space-y-3">
        <%= f.text_field :title,
                         placeholder: "Что купили?",
                         data: {
                           expense_presets_target: "title",
                           expense_form_target: "name",
                           action: "input->expense-form#updateButton"
                         },
                         class: "w-full rounded-xl border border-slate-200 px-4 py-3" %>

        <div class="expense-presets">
          <% expense_presets.each do |preset| %>
            <button
              type="button"
              class="expense-preset"
              data-action="click->expense-presets#set click->expense-form#updateButton"
              data-expense-presets-title="<%= preset[:title] %>">
              <span><%= preset[:emoji] %></span>
              <%= preset[:title] %>
            </button>
          <% end %>
        </div>

        <%= f.text_field :amount,
                         placeholder: "Сумма ₽",
                         inputmode: "decimal",
                         data: {
                           expense_form_target: "amount",
                           action: "input->expense-form#updateButton"
                         },
                         class: "w-full rounded-xl border border-slate-200 px-4 py-3" %>

        <div>
          <p class="text-sm text-slate-500 mb-2">Оплатил</p>

          <div class="flex flex-wrap gap-2">
            <% participants.each_with_index do |participant, index| %>
              <label class="participant-chip">
                <%= radio_button_tag "expense[payer_id]",
                                     participant.id,
                                     index.zero? %>

                <span><%= participant.name %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div>
          <p class="text-sm text-slate-500 mb-2">Кто участвовал</p>

          <div class="flex flex-wrap gap-2">
            <% participants.each do |participant| %>
              <label class="participant-chip">
                <%= check_box_tag "expense[participant_ids][]", participant.id, true %>
                <span><%= participant.name %></span>
              </label>
            <% end %>
          </div>
        </div>

        <%= f.submit "Добавить",
                     disabled: true,
                     data: { expense_form_target: "submit" },
                     class: "expense-submit-button" %>
      </div>
    <% end %>
  </div>
<% end %>