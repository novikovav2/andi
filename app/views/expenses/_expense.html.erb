<div id="<%= dom_id(expense) %>">
  <%= link_to edit_event_expense_path(expense.event, expense),
              data: { turbo_frame: "modal" },
              class: "expense-card-link" do %>

    <div class="expense-card">
      <div class="expense-card-row">
        <div class="expense-left">
          <div class="expense-icon">
            <%= expense_icon(expense) %>
          </div>

          <div class="expense-info">
            <div class="expense-title">
              <%= expense.title %>
            </div>

            <div class="expense-meta">
              Оплатил <%= expense.payer.name %>
            </div>

            <div class="expense-meta-secondary">
              Разделили между: <%= expense.participants.count %>
            </div>
          </div>
        </div>

        <div class="expense-right">
          <div class="expense-amount">
            <%= rubles(expense.amount_cents) %>
          </div>

          <div class="expense-chevron">
            ›
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>