<div class="app-screen">
  <div class="app-container">
    <div class="min-h-screen bg-slate-50 px-4 py-6">
      <div class="max-w-xl mx-auto">


        <%= render "events/header", event: @event, participants: @participants %>
        <%= render "events/status", event: @event %>
        <%= render "events/account_prompt", event: @event %>
        <%= render "events/participants",
                   event: @event,
                   participants: @participants,
                   participant_form: @participant %>

        <%= render "events/settlements",
                   event: @event,
                   settlements: @event.settlements.includes(:from_participant, :to_participant) %>

        <div class="section-header">
          <div>
            <h2 class="section-title">
              Траты
            </h2>

            <p class="section-subtitle">
              Общие покупки
            </p>
          </div>
        </div>

        <% if event_feature_access(@event).receipt_recognition? %>
          <div class="mb-4">
            <% if @participants.any? %>
              <%= link_to "📷 Распознать чек",
                          new_event_receipt_scan_path(@event),
                          class: "inline-flex w-full items-center justify-center rounded-xl bg-blue-50 px-5 py-3 text-sm font-semibold text-blue-700 transition hover:bg-blue-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:w-auto" %>
            <% else %>
              <button type="button"
                      disabled
                      class="inline-flex w-full cursor-not-allowed items-center justify-center rounded-xl bg-slate-100 px-5 py-3 text-sm font-semibold text-slate-400 sm:w-auto">
                📷 Распознать чек
              </button>

              <p class="mt-2 text-sm text-slate-400">
                Сначала добавьте участников события.
              </p>
            <% end %>
          </div>
        <% end %>


        <div id="expense_locked_state">
          <%= render "events/expense_locked_state", participants: @participants %>
        </div>

        <div id="expenses" class="space-y-3">
          <% if @expenses.any? %>
            <%= render @expenses %>
          <% else %>
            <div id="empty_expenses" class="rounded-2xl bg-white shadow-sm p-6 text-center">
              <p class="font-medium text-slate-700">Трат пока нет</p>
              <p class="text-sm text-slate-400 mt-1">
                Добавьте первую трату.
              </p>
            </div>
          <% end %>
        </div>
      </div>

    </div>

    <%= render "events/confirm_bar", event: @event %>
  </div>
</div>

<div id="expense_fab">
  <%= render "events/expense_fab", event: @event, participants: @participants %>
</div>

<%= turbo_frame_tag "modal" %>
