<div id="participants">
<div class="participants-section participants-card">
  <div class="participants-card-header">
    <h2 class="participants-card-title">
      Участники
    </h2>
  </div>

  <% if participants.any? %>
    <div class="participants-avatar-row">
      <% visible_participants_count = participants.count > 6 ? 5 : 6 %>
      <% participants.limit(visible_participants_count).each do |participant_item| %>

        <div class="relative group">
          <%= link_to edit_event_participant_path(event, participant_item),
                      data: { turbo_frame: "modal" },
                      class: "flex h-11 w-11 items-center justify-center rounded-full border-2 border-white text-sm font-semibold shadow-sm #{participant_color(participant_item)}" do %>

            <%= participant_initials(participant_item.name) %>

          <% end %>

        </div>

      <% end %>

      <% if participants.count > visible_participants_count %>
        <%= link_to "+#{participants.count - visible_participants_count}",
                    event_participants_sheet_path(event),
                    data: { turbo_frame: "modal" },
                    class: "participants-overflow-link flex h-11 w-11 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-500 border-2 border-white" %>
      <% end %>
    </div>
  <% else %>
    <div class="participants-empty-state">
      <p class="participants-empty-title">
        Участников пока нет
      </p>

      <p class="participants-empty-text">
        Добавьте людей, чтобы начать делить траты.
      </p>
    </div>
  <% end %>
  <%= form_with model: [event, participant_form], class: "participant-form" do |f| %>
    <%= f.text_field :name,
                     placeholder: "Имя участника",
                     class: "participant-name-input" %>

    <%= f.submit "Добавить",
                 class: "participant-submit" %>
  <% end %>
</div>
</div>
