<div id="participants">
<div class="participants-section">
  <div class="flex items-center justify-between mb-3">
    <div>
      <h2 class="text-sm font-medium text-slate-400 uppercase tracking-wide">
        Участники
      </h2>
    </div>

  </div>

  <% if participants.any? %>
    <div class="participants-avatar-row">
      <% participants.limit(5).each do |participant_item| %>

        <div class="relative group">
          <%= link_to edit_event_participant_path(event, participant_item),
                      data: { turbo_frame: "modal" },
                      class: "flex h-11 w-11 items-center justify-center rounded-full border-2 border-white text-sm font-semibold shadow-sm #{participant_color(participant_item)}" do %>

            <%= participant_initials(participant_item.name) %>

          <% end %>

        </div>

      <% end %>

      <% if participants.count > 5 %>
        <%= link_to "+#{participants.count - 5}",
                    event_participants_sheet_path(event),
                    data: { turbo_frame: "modal" },
                    class: "ml-2 flex h-11 w-11 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-500 border-2 border-white" %>
      <% end %>
    </div>
  <% else %>
    <div class="rounded-2xl bg-slate-50 p-5 text-center">
      <p class="font-medium text-slate-700">
        Участников пока нет
      </p>

      <p class="text-sm text-slate-400 mt-1">
        Добавьте людей, чтобы начать делить траты.
      </p>
    </div>
  <% end %>
  <%= form_with model: [event, participant_form], class: "participant-form" do |f| %>
    <%= f.text_field :name,
                     placeholder: "Имя участника",
                     class: "flex-1 rounded-xl border border-slate-200 px-4 py-3" %>

    <%= f.submit "Добавить",
                 class: "rounded-xl bg-blue-500 text-white px-4 py-3 font-medium" %>
  <% end %>
</div>
</div>