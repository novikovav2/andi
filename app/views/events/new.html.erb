<section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-blue-50 via-white to-emerald-50 border border-slate-200 px-5 py-5 sm:px-8 sm:py-8 lg:min-h-[430px] lg:flex lg:items-center lg:py-12">
  <div class="-mx-5 sm:-mx-8 lg:absolute lg:inset-0 lg:mx-0">
    <%= image_tag(
          "seo/home-hero-mobile.png",
          alt: "Друзья делят общие расходы в Анди",
          width: 1731,
          height: 909,
          loading: "eager",
          srcset: {
            "seo/home-hero-mobile-960.png" => "960w",
            "seo/home-hero-mobile.png" => "1731w"
          },
          sizes: "(min-width: 1024px) 0px, calc(100vw - 68px)",
          class: "h-auto w-full rounded-2xl object-contain lg:hidden"
        ) %>

    <%= image_tag(
          "seo/home-hero-safe-area.png",
          alt: "Друзья делят общие расходы в Анди",
          width: 1536,
          height: 1024,
          loading: "eager",
          srcset: {
            "seo/home-hero-safe-area-960.png" => "960w",
            "seo/home-hero-safe-area.png" => "1536w"
          },
          sizes: "(min-width: 1024px) 720px, 0px",
          class: "hidden h-full w-full object-contain lg:block"
        ) %>
  </div>

  <div id="create-event" class="relative z-10 mt-5 max-w-3xl lg:mt-0 lg:max-w-[460px] lg:rounded-2xl lg:bg-white/90 lg:p-6 lg:shadow-sm lg:ring-1 lg:ring-white/70">
    <p class="mb-2 text-xs font-semibold uppercase text-blue-700 sm:text-sm lg:mb-3">Для поездок, пикников и вечеринок</p>

    <h1 class="text-3xl font-extrabold leading-tight text-slate-950 sm:text-5xl lg:text-4xl">
      Разделить расходы без споров
    </h1>

    <p class="mt-4 max-w-2xl text-base leading-7 text-slate-700 sm:text-lg sm:leading-8 lg:mt-5 lg:text-base lg:leading-7">
      Создайте мероприятие, добавьте участников и расходы — Анди покажет, кто кому сколько должен перевести.
    </p>

    <%= form_with model: @event, class: "mt-5 lg:mt-7" do |f| %>
      <div class="flex flex-col gap-3">
        <%= f.text_field :title,
                         placeholder: "Пикник, поездка, день рождения...",
                         class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-base text-slate-950 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>

        <%= f.submit "Создать мероприятие",
                     class: "inline-flex min-h-13 w-full cursor-pointer items-center justify-center whitespace-nowrap rounded-xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 sm:w-auto lg:min-h-12" %>
      </div>
    <% end %>

    <p class="mt-3 text-sm font-medium leading-6 text-slate-600">
      ✓ Без регистрации<br>
      ✓ Работает с телефона
    </p>
  </div>
</section>

<% if @my_events.any? %>
  <section class="mt-10">
    <div class="section-header">
      <div>
        <h2 class="section-title">Мои события</h2>
        <p class="section-subtitle">События, созданные на этом устройстве</p>
      </div>
    </div>

    <div class="home-events-list">
      <% @my_events.each do |event| %>
        <%= link_to event_share_path(event.access_token),
                    class: "home-event-card" do %>

          <div>
            <div class="home-event-title">
              <%= event.title %>
            </div>

            <div class="home-event-meta">
              <%= event.participants.count %> участников · <%= event_status_label(event) %>
            </div>
          </div>

          <div class="home-event-arrow">›</div>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>

<section class="mt-12">
  <div class="mb-6">
    <p class="text-sm font-semibold uppercase text-emerald-700">Где пригодится</p>
    <h2 class="mt-2 text-3xl font-bold text-slate-950">Для любых общих расходов</h2>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-3xl" aria-hidden="true">🚗</div>
      <h3 class="mt-4 text-xl font-semibold text-slate-950">Поездки</h3>
      <p class="mt-2 leading-7 text-slate-600">Кто-то оплатил жильё, кто-то бензин, кто-то продукты.</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-3xl" aria-hidden="true">🥩</div>
      <h3 class="mt-4 text-xl font-semibold text-slate-950">Пикники</h3>
      <p class="mt-2 leading-7 text-slate-600">Учитывайте мясо, напитки, овощи и другие покупки.</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-3xl" aria-hidden="true">🎉</div>
      <h3 class="mt-4 text-xl font-semibold text-slate-950">Вечеринки</h3>
      <p class="mt-2 leading-7 text-slate-600">Разделяйте расходы на еду, напитки, торт и украшения.</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-3xl" aria-hidden="true">👥</div>
      <h3 class="mt-4 text-xl font-semibold text-slate-950">Любые общие расходы</h3>
      <p class="mt-2 leading-7 text-slate-600">Анди подходит для любых совместных покупок.</p>
    </div>
  </div>
</section>

<section class="mt-12">
  <h2 class="text-3xl font-bold text-slate-950">Как это работает</h2>

  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
    <ol class="list-decimal list-inside space-y-3 text-slate-700">
      <li>Создайте мероприятие.</li>
      <li>Добавьте участников.</li>
      <li>Запишите расходы.</li>
      <li>Отметьте, кто участвовал в каждой покупке.</li>
      <li>Получите готовый список переводов.</li>
    </ol>
  </div>
</section>

<section class="mt-12">
  <div class="mb-6">
    <p class="text-sm font-semibold uppercase text-blue-700">Почему удобно</p>
    <h2 class="mt-2 text-3xl font-bold text-slate-950">Без таблиц и ручных расчётов</h2>
  </div>

  <div class="grid gap-4 md:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-3xl" aria-hidden="true">⚡</div>
      <h3 class="mt-4 text-xl font-semibold text-slate-950">Быстро</h3>
      <p class="mt-2 leading-7 text-slate-600">Не нужны таблицы и калькуляторы.</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-3xl" aria-hidden="true">🎯</div>
      <h3 class="mt-4 text-xl font-semibold text-slate-950">Справедливо</h3>
      <p class="mt-2 leading-7 text-slate-600">Каждая покупка делится только между нужными участниками.</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-3xl" aria-hidden="true">📱</div>
      <h3 class="mt-4 text-xl font-semibold text-slate-950">С телефона</h3>
      <p class="mt-2 leading-7 text-slate-600">Работает прямо в браузере.</p>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="text-3xl" aria-hidden="true">🔒</div>
      <h3 class="mt-4 text-xl font-semibold text-slate-950">Без регистрации</h3>
      <p class="mt-2 leading-7 text-slate-600">Создать мероприятие можно сразу.</p>
    </div>
  </div>
</section>

<section class="mt-12 rounded-2xl border border-slate-200 bg-slate-950 px-5 py-10 text-white sm:px-8">
  <div class="max-w-2xl">
    <h2 class="text-3xl font-bold">Попробуйте прямо сейчас</h2>
    <p class="mt-3 text-lg leading-8 text-slate-200">
      Создание мероприятия занимает меньше минуты.
    </p>

    <%= link_to "Создать мероприятие",
                "#create-event",
                class: "mt-6 inline-flex items-center justify-center rounded-xl bg-white px-6 py-3 text-base font-semibold text-slate-950 shadow-sm transition hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-950" %>
  </div>
</section>
