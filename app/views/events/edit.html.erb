<%= turbo_frame_tag "modal" do %>
  <div
    data-controller="modal"
    class="fixed inset-0 bg-black/30 flex items-end justify-center z-50">

    <div class="bg-white rounded-t-3xl w-full max-w-xl p-5 max-h-[90vh] overflow-y-auto">
      <div class="w-12 h-1.5 bg-slate-300 rounded-full mx-auto mb-5"></div>

      <div class="flex items-center justify-between mb-6">
        <h1 class="text-xl font-semibold text-slate-900">
          Настройки события
        </h1>

        <%= link_to "✕",
                    "#",
                    data: { action: "click->modal#close" },
                    class: "text-slate-400 text-xl" %>
      </div>

      <%= form_with model: @event do |f| %>
        <div class="space-y-4">
          <div>
            <label class="text-sm text-slate-500">Название события</label>

            <%= f.text_field :title,
                             class: "mt-2 w-full rounded-xl border border-slate-200 px-4 py-3" %>
          </div>

          <%= f.submit "Сохранить",
                       class: "w-full rounded-xl bg-blue-500 text-white py-3 font-medium cursor-pointer" %>
        </div>
      <% end %>

      <div class="mt-6 border-t border-slate-100 pt-4">
        <%= button_to "Удалить событие",
                      event_path(@event),
                      method: :delete,
                      form: {
                        data: {
                          controller: "confirm",
                          confirm_message_value: "Все участники, траты и расчёты будут удалены. Это действие нельзя отменить.",
                          confirm_confirm_text_value: "Удалить",
                          confirm_cancel_text_value: "Отмена",
                          turbo: false
                        }
                      },
                      data: {
                        action: "click->confirm#ask",
                      },
                      class: "w-full rounded-xl border border-red-200 text-red-500 py-3 font-medium" %>
      </div>
    </div>
  </div>
<% end %>